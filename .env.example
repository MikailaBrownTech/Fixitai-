# Copy this file to .env (which git ignores) and fill in real values.
# NEVER put real keys in this example file: it IS committed.

# Which LLM implementation to use: mock (free, default) | anthropic
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=anthropic. Leave blank otherwise.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (the cheapest current model per the Anthropic docs).
ANTHROPIC_MODEL=
